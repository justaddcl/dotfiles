{
  "window.commandCenter": true,
  "terminal.integrated.env.osx": {},
  "workbench.sideBar.location": "right",
  "workbench.colorTheme": "poimandres-storm",

  "breadcrumbs.enabled": true,

  // "emmet.showSuggestionsAsSnippets": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "TypeScript React": "typescriptreact",
    "HTML": "html"
  },

  // settings from VS Code
  "editor.fontFamily": "Fira Code, Menlo, Monaco, 'Courier New', monospace",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,

  // language options
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
    // "editor.formatOnSave": false
  },
  "[javascriptreact]": {
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[typescriptreact]": {
    "emmet.triggerExpansionOnTab": true,
    "emmet.showAbbreviationSuggestions": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },

  "javascript.updateImportsOnFileMove.enabled": "always",

  // Rename/refactor symbols without getting alias `oldName as newName`
  "javascript.preferences.useAliasesForRenames": false,
  "typescript.preferences.useAliasesForRenames": false,

  // tell the ESLint plugin to run on save
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "eslint.validate": [
    "markdown",
    "mdx",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.fontLigatures": "enable",
  "editor.snippetSuggestions": "inline",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.occurrencesHighlight": "multiFile",
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.cursorSurroundingLinesStyle": "all",

  "workbench.editor.splitInGroupLayout": "vertical",
  "workbench.activityBar.location": "top",
  // "workbench.colorCustomizations": {
  //   "statusBar.background": "#005f5f",
  //   "statusBar.noFolderBackground": "#005f5f",
  //   "statusBar.debuggingBackground": "#005f5f",
  //   "statusBar.foreground": "#ffffff",
  //   "statusBar.debuggingForeground": "#ffffff"
  // },
  "workbench.editor.customLabels.patterns": {
    "*/src/**/index.ts": "${dirname}/${filename}.${extname}",
    "*/src/**/spec.tsx": "${dirname}/${filename}.${extname} 🧪",
    "*/src/**/spec.ts": "${dirname}/${filename}.${extname} 🧪",
    "*/src/**/index.tsx": "${dirname}/${filename}.${extname} 🏗️"
  },

  "diffEditor.diffAlgorithm": "advanced",

  "git.mergeEditor": true,

  "gitlens.rebaseEditor.ordering": "asc",
  "githubPullRequests.pullBranch": "never",

  "cSpell.userWords": [
    "aics",
    "airplanemode",
    "apos",
    "audiobook",
    "Authorisation",
    "blocklist",
    "camelcase",
    "chakra",
    "chiaro",
    "Chromeless",
    "codepen",
    "colours",
    "Datapoint",
    "datetime",
    "Dismissable",
    "dribbble",
    "dropdown",
    "ecommerce",
    "endforeach",
    "Faktum",
    "Figtree",
    "firestore",
    "fontawesome",
    "formik",
    "fortawesome",
    "fqcn",
    "fullname",
    "Fullstory",
    "gstatic",
    "headshot",
    "hlsearch",
    "htmlescape",
    "Hygen",
    "iban",
    "idempotency",
    "initialise",
    "initialised",
    "justaddcl",
    "kennitala",
    "kleur",
    "lastfm",
    "magento",
    "magpul",
    "Mantine",
    "Martine",
    "meilisearch",
    "Moiwayama",
    "monospace",
    "nextjs",
    "noopener",
    "noreferrer",
    "nydev",
    "onboarded",
    "organisation",
    "organisations",
    "phpdoc",
    "plusplus",
    "prioritise",
    "pubsub",
    "quickstart",
    "realise",
    "sanbi",
    "sanitise",
    "sanitised",
    "Sanitising",
    "scroller",
    "Setlist",
    "signin",
    "smoothscroll",
    "spotify",
    "stoneway",
    "storyous",
    "tada",
    "tanstack",
    "tapi",
    "testid",
    "textnodes",
    "Teya",
    "TRPC",
    "typehint",
    "unarchived",
    "Unmute",
    "unsets",
    "visualstar",
    "wireframe",
    "xxxl",
    "yneo",
    "yuji",
    "yujinelson",
    "zustand"
  ],

  // ** spotify extension settings ** //
  "spotify.showMuteUnmuteVolumeButton": false,
  "spotify.showToggleRepeatingButton": true,
  "spotify.trackInfoFormat": "artistName - trackName - albumName",
  "spotify.showLyricsButton": false,

  // ** vim settings ** //

  // leader key
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.visualstar": true,

  // normal mode key bindings
  "vim.normalModeKeyBindings": [
    {
      "before": ["L"],
      "after": ["$"]
    },
    {
      "before": ["H"],
      "after": ["^"]
    },
    {
      "before": ["g", "p", "d"],
      "commands": ["editor.action.peekDefinition"]
    },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["g", "p", "i"],
      "commands": ["editor.action.peekImplementation"]
    },
    {
      "before": ["g", "q"],
      "commands": ["editor.action.quickFix"]
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.referenceSearch.trigger"]
    },
    {
      "before": ["g", "t"],
      "commands": ["editor.action.goToTypeDefinition"]
    },
    {
      "before": ["g", "p", "t"],
      "commands": ["editor.action.peekTypeDefinition"]
    },
    {
      "key": "h",
      "command": "editor.action.scrollLeftHover",
      "when": "editorHoverFocused"
    },
    {
      "key": "j",
      "command": "editor.action.scrollDownHover",
      "when": "editorHoverFocused"
    },
    {
      "key": "k",
      "command": "editor.action.scrollUpHover",
      "when": "editorHoverFocused"
    },
    {
      "key": "l",
      "command": "editor.action.scrollRightHover",
      "when": "editorHoverFocused"
    }
    // {
    //   "before": [":"],
    //   "commands": ["workbench.action.showCommands"],
    //   "silent": true
    // }
  ],
  "vim.insertModeKeyBindings": [{ "before": ["j", "j"], "after": ["<Esc>"] }],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    },
    {
      "before": ["p"],
      "after": ["p", "g", "v", "y"]
    }
  ],
  "vim.operatorPendingModeKeyBindings": [
    {
      "before": ["L"],
      "after": ["$"]
    },
    {
      "before": ["H"],
      "after": ["^"]
    }
  ],

  // highlight after yank
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "#a9dc7660",
  "vim.highlightedyank.duration": 350,

  // yank to system clipboard
  "vim.useSystemClipboard": true, // misc

  // change the bottom bar color depending on vim mode
  "vim.statusBarColorControl": true,

  // "vim.enableNeovim": true,
  // "vim.neovimUseConfigFile": true,
  // "vim.neovimConfigPath": "~/.config/nvim/init.lua",
  // "vim.neovimPath": "/opt/homebrew/bin/nvim",
  "vim.camelCaseMotion.enable": true,
  "vim.searchHighlightTextColor": "#a9dc7660",
  // "extensions.experimental.affinity": {
  //   "vscodevim.vim": 1
  // },
  "circleci.hostUrl": "",

  "totalTypeScript.hideAllTips": false,
  "totalTypeScript.hideBasicTips": true,
  "totalTypeScript.hiddenTips": [
    "type-alias-declaration",
    "union-type",
    "null-keyword",
    "type-alias-with-generics",
    "ts-object-type",
    "basic-types",
    "any-type",
    "optional-object-property",
    "literal-type",
    "passing-generics-to-types",
    "non-null-expression",
    "typing-function-parameters",
    "pick-utility-type",
    "array-type",
    "variable-type-annotation",
    "generic-slots-in-functions",
    "mapped-type",
    "omit-utility-type",
    "nonnullable-utility-type",
    "keyof",
    "function-return-type",
    "undefined-keyword",
    "record-utility-type",
    "typeof",
    "as-assertion",
    "tuple-type",
    "as-const",
    "partial-utility-type",
    "never-keyword",
    "required-utility-type",
    "type-predicate",
    "type-alias-with-multiple-generics",
    "exclude-utility-type",
    "in-operator-narrowing",
    "as-const-on-object"
  ],
  "typescript.updateImportsOnFileMove.enabled": "always",
  "diffEditor.renderSideBySide": true,
  "diffEditor.experimental.showMoves": true,

  // Neovim settings
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "vscode-neovim.compositeKeys": {
    "jj": {
      "command": "vscode-neovim.escape"
    }
  },
  "workbench.colorCustomizations": {
    "statusBar.background": "#005f87",
    "statusBar.noFolderBackground": "#005f87",
    "statusBar.debuggingBackground": "#005f87",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingForeground": "#ffffff"
  },
  "vim.enableNeovim": true,
  "vim.neovimPath": "/opt/homebtew/bin/nvim",
  "vim.neovimConfigPath": "~/.config/nvim/init.lua",
  "cursor.composer.shouldChimeAfterChatFinishes": true,

  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["s"],
      "commands": ["flash-vscode.start"]
    },
    {
      "before": ["S"],
      "commands": ["flash-vscode.startSelection"]
    },
    {
      "before": ["<BS>"],
      "commands": ["flash-vscode.backspace"]
    }
  ],
  "diffEditor.ignoreTrimWhitespace": false,
  "console-ninja.toolsToEnableSupportAutomaticallyFor": {
    "jest": false
  },
  "geminicodeassist.updateChannel": "Insiders",
  "console-ninja.featureSet": "Community",
  "diffEditor.codeLens": true,
  "geminicodeassist.inlineSuggestions.enableAuto": false,
  "editor.gotoLocation.multipleReferences": "gotoAndPeek",
  "turboConsoleLog.addSemicolonInTheEnd": true,
  "turboConsoleLog.logFunction": "log('', JSON.stringify({}, null, 2);",
  "kilo-code.allowedCommands": ["git log", "git diff", "git show"],
  "kilo-code.deniedCommands": [],
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "geminicodeassist.displayInlineContextHint": false,
  "geminicodeassist.enable": false
}
