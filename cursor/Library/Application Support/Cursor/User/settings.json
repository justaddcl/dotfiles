{
  "html.format.indentInnerHtml": true,
  "workbench.editor.showTabs": "multiple",
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "TypeScript React": "typescriptreact",
    "HTML": "html"
  },
  "workbench.panel.defaultLocation": "right",
  "breadcrumbs.enabled": true,
  "editor.tabSize": 2,
  "terminal.integrated.fontFamily": "Fira Mono For Powerline",
  "workbench.colorTheme": "Tokyo Night Storm",
  "window.title": "${dirty} ${activeEditorMedium}${separator}${rootName}",
  "editor.formatOnSave": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[typescriptreact]": {
    "emmet.triggerExpansionOnTab": true,
    "emmet.showAbbreviationSuggestions": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.preferences.useAliasesForRenames": false,
  "typescript.preferences.useAliasesForRenames": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "eslint.validate": [
    "markdown",
    "mdx",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "workbench.tree.indent": 15,
  "workbench.tree.renderIndentGuides": "always",
  "editor.multiCursorModifier": "alt",
  "editor.tabCompletion": "on",
  "files.associations": {
    "*.m2urlrc": "json"
  },
  "editor.fontLigatures": "enable",
  "debug.javascript.autoAttachFilter": "onlyWithFlag",
  "cSpell.userWords": [
    "aics",
    "airplanemode",
    "apos",
    "audiobook",
    "Authorisation",
    "blocklist",
    "camelcase",
    "chakra",
    "chiaro",
    "Chromeless",
    "codepen",
    "colours",
    "Datapoint",
    "datetime",
    "Dismissable",
    "dribbble",
    "dropdown",
    "ecommerce",
    "endforeach",
    "Faktum",
    "Figtree",
    "firestore",
    "fontawesome",
    "formik",
    "fortawesome",
    "fqcn",
    "fullname",
    "Fullstory",
    "gstatic",
    "headshot",
    "htmlescape",
    "Hygen",
    "iban",
    "idempotency",
    "initialise",
    "initialised",
    "justaddcl",
    "kennitala",
    "kleur",
    "lastfm",
    "magento",
    "magpul",
    "Mantine",
    "Martine",
    "meilisearch",
    "Moiwayama",
    "monospace",
    "nextjs",
    "noopener",
    "noreferrer",
    "nydev",
    "onboarded",
    "organisation",
    "organisations",
    "ORPC",
    "phpdoc",
    "plusplus",
    "prioritise",
    "pubsub",
    "quickstart",
    "realise",
    "sanbi",
    "sanitise",
    "sanitised",
    "Sanitising",
    "scroller",
    "Setlist",
    "signin",
    "smoothscroll",
    "spotify",
    "stoneway",
    "storyous",
    "tada",
    "tanstack",
    "tapi",
    "testid",
    "textnodes",
    "Teya",
    "treeify",
    "TRPC",
    "typehint",
    "unarchived",
    "unsets",
    "wireframe",
    "xxxl",
    "yneo",
    "yuji",
    "yujinelson",
    "zustand"
  ],
  "window.openFilesInNewWindow": "on",
  "files.defaultLanguage": "`${activeEditorLanguage} `",
  "explorer.compactFolders": false,
  "editor.snippetSuggestions": "bottom",
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "editor.suggest.showStatusBar": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.integrated.fontWeightBold": "bold",
  "editor.fontFamily": "Fira Code, Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.fontSize": 13,
  "spotify.showMuteUnmuteVolumeButton": false,
  "spotify.showToggleRepeatingButton": true,
  "spotify.trackInfoFormat": "artistName - trackName - albumName",
  "spotify.showLyricsButton": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.suggest.preview": true,
  "editor.accessibilitySupport": "off",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "editor.gotoLocation.multipleTypeDefinitions": "gotoAndPeek",
  "editor.gotoLocation.multipleDefinitions": "gotoAndPeek",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.linkedEditing": true,
  "editor.guides.indentation": false,
  "gitlens.views.stashes.files.layout": "tree",
  "git.experimental.mergeEditor": true,
  "git.mergeEditor": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "window.commandCenter": true,
  "githubPullRequests.pullBranch": "never",
  "workbench.experimental.settingsProfiles.enabled": true,
  "gitlens.rebaseEditor.ordering": "asc",
  "workbench.editorAssociations": {
    "git-rebase-todo": "gitlens.rebase"
  },
  "editor.stickyScroll.enabled": true,
  "auto-close-tag.activationOnLanguage": ["xml", "mdx"],
  "[plaintext]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false
  },
  "diffEditor.diffAlgorithm": "advanced",
  "[dotenv]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "totalTypeScript.hiddenTips": [
    "type-alias-declaration",
    "union-type",
    "null-keyword",
    "type-alias-with-generics",
    "ts-object-type",
    "basic-types",
    "any-type",
    "optional-object-property",
    "literal-type",
    "passing-generics-to-types",
    "non-null-expression",
    "typing-function-parameters",
    "pick-utility-type",
    "array-type",
    "variable-type-annotation",
    "generic-slots-in-functions",
    "mapped-type",
    "omit-utility-type",
    "nonnullable-utility-type",
    "keyof",
    "function-return-type",
    "undefined-keyword",
    "record-utility-type",
    "typeof",
    "as-assertion",
    "tuple-type",
    "as-const",
    "partial-utility-type",
    "never-keyword",
    "required-utility-type",
    "type-predicate",
    "type-alias-with-multiple-generics",
    "exclude-utility-type",
    "as-const-on-object"
  ],
  "workbench.editor.splitInGroupLayout": "vertical",
  "cSpell.ignoreWords": ["Localised", "Serie", "Timeslice"],
  "editor.occurrencesHighlight": "multiFile",
  "dart.debugExternalPackageLibraries": true,
  "dart.debugSdkLibraries": true,
  "editor.lineNumbers": "relative",
  "console-ninja.fontSize": 12,
  "workbench.editor.customLabels.patterns": {
    "*/src/**/page.tsx": "Page - ${dirname}",
    "*/src/**/layout.tsx": "Layout - ${dirname}",
    "*/src/**/spec.tsx": "${dirname}/${filename}.${extname}",
    "*/src/**/stories.tsx": "${dirname}/${filename}.${extname}",
    "*/src/**/spec.ts": "${dirname}/${filename}.${extname}",
    "*/src/**/index.tsx": "${dirname}",
    "*/src/**/index.ts": "${dirname}"
  },
  "todohighlight.keywords": [
    {
      "text": "NOTE:",
      "color": "#172554",
      "backgroundColor": "#7dd3fc"
    },
    {
      "text": "HACK:",
      "color": "#422006",
      "backgroundColor": "#fef9c3"
    }
  ],
  "vim.leader": "<space>",
  "vim.normalModeKeyBindings": [
    {
      "before": ["L"],
      "after": ["$"]
    },
    {
      "before": ["H"],
      "after": ["^"]
    },
    {
      "before": ["g", "p", "d"],
      "commands": ["editor.action.peekDefinition"]
    },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["g", "p", "i"],
      "commands": ["editor.action.peekImplementation"]
    },
    {
      "before": ["g", "q"],
      "commands": ["editor.action.quickFix"]
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.referenceSearch.trigger"]
    },
    {
      "before": ["g", "t"],
      "commands": ["editor.action.goToTypeDefinition"]
    },
    {
      "before": ["g", "p", "t"],
      "commands": ["editor.action.peekTypeDefinition"]
    },
    {
      "key": "h",
      "command": "editor.action.scrollLeftHover",
      "when": "editorHoverFocused"
    },
    {
      "key": "j",
      "command": "editor.action.scrollDownHover",
      "when": "editorHoverFocused"
    },
    {
      "key": "k",
      "command": "editor.action.scrollUpHover",
      "when": "editorHoverFocused"
    },
    {
      "key": "l",
      "command": "editor.action.scrollRightHover",
      "when": "editorHoverFocused"
    }
  ],
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    },
    {
      "before": ["p"],
      "after": ["p", "g", "v", "y"]
    }
  ],
  "vim.operatorPendingModeKeyBindings": [
    {
      "before": ["L"],
      "after": ["$"]
    },
    {
      "before": ["H"],
      "after": ["^"]
    }
  ],
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "#a9dc7660",
  "vim.highlightedyank.duration": 350,
  "vim.useSystemClipboard": true,
  "vim.statusBarColorControl": true,
  "workbench.colorCustomizations": {
    "statusBar.background": "#5f00af",
    "statusBar.noFolderBackground": "#5f00af",
    "statusBar.debuggingBackground": "#5f00af",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingForeground": "#ffffff",
    "titleBar.activeForeground": "#000",
    "titleBar.inactiveForeground": "#000000CC",
    "titleBar.activeBackground": "#DBC8FF",
    "titleBar.inactiveBackground": "#DBC8FFCC"
  },
  "vim.enableNeovim": true,
  "vim.hlsearch": true,
  "vim.neovimUseConfigFile": true,
  "mvim.camelCaseMotion.enable": true,
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },
  "editor.minimap.enabled": false,
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "editor.cursorSurroundingLines": 0,
  "editor.cursorSurroundingLinesStyle": "all",
  "scm.experimental.showHistoryGraph": true,
  "circleci.hostUrl": "",
  "totalTypeScript.hideAllTips": false,
  "totalTypeScript.hideBasicTips": true,
  "editor.lineHeight": 0,
  "editor.fontSize": 13,
  "workbench.sideBar.location": "right",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    ".*ClassName.*",
    "ngClass",
    "class:list",
    "color"
  ],
  "turboConsoleLog.includeFilename": true,
  "turboConsoleLog.includeLineNum": true,
  "turboConsoleLog.addSemicolonInTheEnd": true,
  "cursor.cpp.enablePartialAccepts": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.renderSideBySide": true,
  "vim.neovimPath": "/run/current-system/sw/bin/nvim",
  "vim.sneakUseIgnorecaseAndSmartcase": true,
  "vim.startofline": false,

  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["s"],
      "commands": ["flash-vscode.start"]
    },
    {
      "before": ["S"],
      "commands": ["flash-vscode.startSelection"]
    },
    {
      "before": ["<BS>"],
      "commands": ["flash-vscode.backspace"]
    }
  ],
  "diffEditor.codeLens": true
}
