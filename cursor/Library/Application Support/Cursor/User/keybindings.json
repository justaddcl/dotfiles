// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+shift+l",
    "command": "turboConsoleLog.displayLogMessage"
  },
  {
    "key": "ctrl+alt+l",
    "command": "-turboConsoleLog.displayLogMessage"
  },
  {
    "key": "shift+cmd+v",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active"
  },
  {
    "key": "ctrl+shift+g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active"
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent"
  },

  // Neovim keybindings
  {
    "args": "<C-d>",
    "command": "vscode-neovim.send",
    "key": "cmd+d",
    "when": "editorFocus && neovim.init"
  },
  {
    "args": "<CS-d>",
    "command": "vscode-neovim.send",
    "key": "cmd+shift+d",
    "when": "editorFocus && neovim.init"
  },
  {
    "args": "<CS-l>",
    "command": "vscode-neovim.send",
    "key": "cmd+shift+l",
    "when": "editorFocus && neovim.init"
  },

  // cursor key bindings
  {
    "key": "cmd+i",
    "command": "composerMode.agent"
  },
  {
    "key": "cmd+k cmd+a",
    "command": "aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  },
  {
    "key": "cmd+k",
    "command": "-aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  },

  // editor key bindings
  {
    "key": "cmd+r cmd+k",
    "command": "workbench.action.focusAboveGroup"
  },
  {
    "key": "cmd+r cmd+up",
    "command": "-workbench.action.focusAboveGroup"
  },
  {
    "key": "cmd+r cmd+j",
    "command": "workbench.action.focusBelowGroup"
  },
  {
    "key": "cmd+r cmd+down",
    "command": "-workbench.action.focusBelowGroup"
  },
  {
    "key": "cmd+r cmd+h",
    "command": "workbench.action.focusLeftGroup"
  },
  {
    "key": "cmd+r cmd+left",
    "command": "-workbench.action.focusLeftGroup"
  },
  {
    "key": "cmd+r cmd+l",
    "command": "workbench.action.focusRightGroup"
  },
  {
    "key": "cmd+r cmd+right",
    "command": "-workbench.action.focusRightGroup"
  },
  {
    "key": "cmd+r cmd+\\",
    "command": "-workbench.action.splitEditorUp"
  },
  {
    "key": "cmd+r j",
    "command": "workbench.action.moveActiveEditorGroupDown"
  },
  {
    "key": "cmd+r down",
    "command": "-workbench.action.moveActiveEditorGroupDown"
  },
  {
    "key": "cmd+r h",
    "command": "workbench.action.moveActiveEditorGroupLeft"
  },
  {
    "key": "cmd+r left",
    "command": "-workbench.action.moveActiveEditorGroupLeft"
  },
  {
    "key": "cmd+r l",
    "command": "workbench.action.moveActiveEditorGroupRight"
  },
  {
    "key": "cmd+r right",
    "command": "-workbench.action.moveActiveEditorGroupRight"
  },
  {
    "key": "cmd+r k",
    "command": "workbench.action.moveActiveEditorGroupUp"
  },
  {
    "key": "cmd+r up",
    "command": "-workbench.action.moveActiveEditorGroupUp"
  },

  // focus keybindings
  {
    "key": "cmd+r cmd+r",
    "command": "workbench.action.focusFirstEditorGroup"
  },
  {
    "key": "cmd+1",
    "command": "-workbench.action.focusFirstEditorGroup"
  },
  {
    "key": "cmd+r cmd+t",
    "command": "workbench.action.focusSideBar"
  },
  {
    "key": "cmd+0",
    "command": "-workbench.action.focusSideBar"
  },
  {
    "key": "cmd+r cmd+e",
    "command": "workbench.action.focusAuxiliaryBar"
  },
  {
    "key": "cmd+r alt+cmd+t",
    "command": "workbench.action.selectTheme"
  },
  {
    "key": "cmd+r cmd+t",
    "command": "-workbench.action.selectTheme"
  },
  {
    "key": "cmd+r shift+cmd+t",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+r shift+cmd+e",
    "command": "workbench.action.toggleAuxiliaryBar"
  },
  {
    "key": "alt+cmd+b",
    "command": "-workbench.action.toggleAuxiliaryBar"
  },

  // file explorer key bindings to mimic nvim tree
  {
    "key": "enter",
    "command": "filesExplorer.openFilePreserveFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "e",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "enter",
    "command": "-renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus"
  },
  {
    "key": "cmd+c",
    "command": "-filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "cmd+v",
    "command": "-filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "cmd+x",
    "command": "-filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "cmd+shift+w",
    "command": "workbench.files.action.collapseExplorerFolders"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "d",
    "command": "moveFileToTrash",
    "when": "explorerResourceMoveableToTrash && filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "delete",
    "command": "-moveFileToTrash",
    "when": "explorerResourceMoveableToTrash && filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "shift+w",
    "command": "list.collapse",
    "when": "listFocus && treeElementCanCollapse && !inputFocus && !treestickyScrollFocused || listFocus && treeElementHasParent && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "shift+p",
    "command": "list.focusParent",
    "when": "listFocus && treeElementCanCollapse && !inputFocus && !treestickyScrollFocused || listFocus && treeElementHasParent && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "shift+S",
    "command": "list.find",
    "when": "listFocus && listSupportsFind && !inputFocus"
  },
  {
    "key": "shift+k",
    "command": "list.focusAnyFirst",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "shift+j",
    "command": "list.focusAnyLast",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "enter",
    "command": "list.expand",
    "when": "listFocus && treeElementCanExpand && !inputFocus && !treestickyScrollFocused || listFocus && treeElementHasChild && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.files.action.showActiveFileInExplorer",
    "when": " filesExplorerFocus && foldersViewVisible && !inputFocus"
  },
  {
    "key": "cmd+r cmd+d",
    "command": "workbench.action.splitEditorInGroup",
    "when": "activeEditorCanSplitInGroup"
  },
  {
    "key": "cmd+r cmd+d",
    "command": "workbench.action.joinEditorInGroup",
    "when": "sideBySideEditorActive"
  },
  {
    "key": "cmd+r shift+cmd+j",
    "command": "workbench.action.splitEditorToBelowGroup"
  },
  {
    "key": "cmd+r shift+cmd+k",
    "command": "workbench.action.splitEditorToAboveGroup"
  },
  {
    "key": "cmd+r shift+cmd+h",
    "command": "workbench.action.splitEditorToLeftGroup"
  },
  {
    "key": "cmd+r shift+cmd+l",
    "command": "workbench.action.splitEditorToRightGroup"
  },
  {
    "key": "cmd+r n",
    "command": "workbench.action.navigateEditorGroups"
  }
]
